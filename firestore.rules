rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function ownsResource() {
      return request.auth != null && resource.data.userId == request.auth.uid;
    }

    function willOwnResource() {
      return request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Validate data exists and is a map
    function isValidMap(data) {
      return data is map;
    }

    // Validate string field
    function isValidString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // =======================
    // USER PROFILES
    // =======================
    match /users/{userId} {
      // Read own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      // Create own profile
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'fullName'])
        && request.resource.data.email is string
        && request.resource.data.fullName is string;
      
      // No update allowed for security
      allow update: if false;
      allow delete: if false;

      // User's private data subcollections
      match /pdfNotes/{noteId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null && request.auth.uid == userId && resource.data.userId == userId;
      }

      match /standaloneNotes/{noteId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null && request.auth.uid == userId && resource.data.userId == userId;
      }

      match /mockTests/{testId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /pyqAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /pyqActivities/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /mockTestActivities/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Planner Tasks (subcollection)
      match /plannerTasks/{taskId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // =======================
    // ADMIN COLLECTIONS
    // =======================
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // =======================
    // PUBLIC CONTENT (Readable by all, writable by admin)
    // =======================
    
    // Subjects & PDFs
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      
      // Validate subject data
      allow create: if isAdmin() && request.resource.data.keys().hasAll(['name']);
      
      match /pdfs/{pdfId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /pdfSubjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasAll(['name']);
    }

    match /noteCollections/{collectionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasAll(['name']);
    }

    match /pdfs/{pdfId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      // Validate PDF data
      allow create: if isAdmin() && request.resource.data.keys().hasAll(['title', 'url']);
    }

    // Notes (shared)
    match /notes/{noteId} {
      allow read: if request.auth != null;
      allow create: if willOwnResource() && request.resource.data.keys().hasAll(['title', 'userId']);
      allow update, delete: if ownsResource();
    }

    // Mock Tests
    match /mockTests/{testId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasAll(['title', 'questions']);
    }

    match /users/{userId}/mockTests/{testId} {
      allow read, write: if isOwner(userId);
    }

    // PYQs
    match /pyqSubjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /pyqs/{pyqId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      
      match /pdfs/{pdfId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // User test attempts
    match /users/{userId}/mockTestAttempts/{attemptId} {
      allow read, write: if isOwner(userId);
    }

    // User PYQ sessions
    match /user_pyq_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if willOwnResource();
      allow update, delete: if ownsResource();
    }

    // User PYQ progress
    match /user_pyq_progress/{progressId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Leaderboard
    match /leaderboard/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Admin Notifications
    match /adminNotifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Current Affairs
    match /currentAffairs/{affairId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasAll(['title', 'date']);
    }

    // SSB Materials
    match /ssb_ppdt_pictures/{pictureId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ssb_tat_pictures/{pictureId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ssb_wat_words/{wordId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ssb_srt_situations/{situationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ssb_test_results/{resultId} {
      allow read: if request.auth != null;
      allow create: if willOwnResource();
      allow update, delete: if ownsResource();
    }

    // Tasks (Planner)
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if willOwnResource();
      allow update, delete: if ownsResource();
    }

    // User Logins
    match /userLogins/{loginId} {
      allow read: if request.auth != null;
      allow create: if willOwnResource();
      allow update, delete: if ownsResource();
    }

    match /users/{userId}/pyqAttempts/{attemptId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/pyqActivities/{activityId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/mockTestActivities/{activityId} {
      allow read, write: if isOwner(userId);
    }

    // =======================
    // PUBLIC READ-ONLY CONTENT
    // =======================
    
    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Success Stories - Public
    match /enliftSuccessStories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Blogs - Public
    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Programs - Public
    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
