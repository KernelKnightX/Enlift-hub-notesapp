rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.isAdmin == true;
    }

    function ownsResource() {
      return request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    function willOwnResource() {
      return request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {

      // Students see themselves. Admins see the full registered roster.
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'email',
          'fullName'
        ])
        && request.resource.data.email is string
        && request.resource.data.fullName is string;

      // Students may only bump streak fields.
      // Admins may update any field (including isAdmin).
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'studyStreak',
              'bestStreak',
              'lastStudyDate',
              'streakUpdatedAt'
            ]));

      allow delete: if false;

      match /stats/{statId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /pdfNotes/{noteId} {
        allow read, create: if isOwner(userId);

        allow update, delete:
          if isOwner(userId)
          && resource.data.userId == userId;
      }

      match /standaloneNotes/{noteId} {
        allow read, create: if isOwner(userId);

        allow update, delete:
          if isOwner(userId)
          && resource.data.userId == userId;
      }

      match /mockTests/{testId} {
        allow read, write: if isOwner(userId);
      }

      match /pyqAttempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }

      match /pyqActivities/{activityId} {
        allow read, write: if isOwner(userId);
      }

      match /mockTestActivities/{activityId} {
        allow read, write: if isOwner(userId);
      }

      match /plannerTasks/{taskId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /mockTestAttempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }

      match /mistakes/{mistakeId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /topicStats/{topicId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /studyPlan/{dateId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /studySettings/{settingsId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();

      allow create, update, delete: if isAdmin();

      match /pdfs/{pdfId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /pdfSubjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /noteCollections/{collectionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /pdfs/{pdfId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['downloadCount', 'openCount', 'updatedAt']));
    }

    match /notes/{noteId} {
      allow read: if isAuthenticated();

      allow create:
        if willOwnResource()
        && request.resource.data.keys().hasAll([
          'title',
          'userId'
        ]);

      allow update, delete: if ownsResource();
    }

    match /mockTests/{testId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['attemptCount', 'updatedAt']));
    }

    // Office-visible mock results. Students write their own row; admins read everyone.
    match /mockAttempts/{attemptId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /officeEvents/{eventId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['type', 'userId', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }

    match /pyqSubjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /pyqs/{pyqId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();

      match /pdfs/{pdfId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /user_pyq_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if willOwnResource();
      allow update, delete: if ownsResource();
    }

    match /user_pyq_progress/{progressId} {
      allow read: if isAuthenticated();

      allow create:
        if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update, delete:
        if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /leaderboard/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Motivational quotes shown on the student dashboard
    match /topperTips/{tipId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /trendingHashtags/{hashtagId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /adminNotifications/{notificationId} {
      allow read:
        if isAuthenticated()
        || (
          resource.data.isActive == true
          && resource.data.href is string
          && resource.data.href.size() > 0
          && (
            !('target' in resource.data)
            || resource.data.target == 'home'
            || resource.data.target == 'both'
          )
        );
      allow create, update, delete: if isAdmin();
    }

    match /currentAffairs/{affairId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /maps/{mapId} {
      allow read:
        if resource.data.status == 'published'
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }

    match /ssb_ppdt_pictures/{pictureId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ssb_tat_pictures/{pictureId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ssb_wat_words/{wordId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ssb_srt_situations/{situationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ssb_test_results/{resultId} {
      allow read: if isAuthenticated();
      allow create: if willOwnResource();
      allow update, delete: if ownsResource();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if willOwnResource();
      allow update, delete: if ownsResource();
    }

    match /userLogins/{loginId} {
      allow read: if isAuthenticated();
      allow create: if willOwnResource();
      allow update, delete: if ownsResource();
    }

    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /enliftSuccessStories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /userNotes/{noteId} {
      allow read:
        if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create:
        if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update, delete:
        if request.auth != null
        && resource.data.userId == request.auth.uid;

      match /versions/{versionId} {
        allow read, create:
          if request.auth != null
          && get(/databases/$(database)/documents/userNotes/$(noteId)).data.userId == request.auth.uid;

        allow delete:
          if request.auth != null
          && get(/databases/$(database)/documents/userNotes/$(noteId)).data.userId == request.auth.uid;
      }
    }

    match /monthlyMagazines/{magazineId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /ncertBooks/{bookId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bookSubjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /government/{itemId} {
      allow read:
        if resource.data.status == 'published'
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }

    match /publicPages/{pageId} {
      allow read:
        if resource.data.status == 'published'
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }
  }
}
